'use client';

import { useState } from 'react';

export default function Home() {
  const [file, setFile] = useState<File | null>(null);
  const [loading, setLoading] = useState(false);
  const [result, setResult] = useState<any>(null);

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!file) return alert('画像を選択してください');

    setLoading(true);
    setResult(null);

    const formData = new FormData();
    formData.append('file', file);

    try {
      const res = await fetch('/api/analyze', {
        method: 'POST',
        body: formData,
      });
      const data = await res.json();
      if (res.ok) {
        setResult(data);
      } else {
        alert('エラーが発生しました: ' + data.error);
      }
    } catch (err) {
      alert('通信エラーが発生しました');
    } finally {
      setLoading(false);
    }
  };

  return (
    <main style={{ padding: '20px', maxWidth: '600px', margin: '0 auto', fontFamily: 'sans-serif' }}>
      <h1>📸 分からない問題を撮影</h1>
      
      <form onSubmit={handleSubmit} style={{ display: 'flex', flexDirection: 'column', gap: '15px' }}>
        <input 
          type="file" 
          accept="image/*" 
          onChange={(e) => setFile(e.target.files?.[0] || null)} 
        />
        <button 
          type="submit" 
          disabled={loading}
          style={{ padding: '12px', background: '#0070f3', color: '#fff', border: 'none', borderRadius: '5px', fontSize: '16px' }}
        >
          {loading ? 'AI解析＆動画生成中...' : '解説動画を作成する'}
        </button>
      </form>

      {result && (
        <div style={{ marginTop: '30px', border: '1px solid #ccc', borderRadius: '8px', padding: '15px' }}>
          <h2>💡 解説プレイヤー</h2>
          {result.script?.steps?.map((step: any, index: number) => (
            <div key={index} style={{ marginBottom: '15px', background: '#f9f9f9', padding: '10px', borderRadius: '5px' }}>
              <h3>Step {step.step_number}: {step.title}</h3>
              <p>{step.narration}</p>
            </div>
          ))}
        </div>
      )}
    </main>
  );
}
