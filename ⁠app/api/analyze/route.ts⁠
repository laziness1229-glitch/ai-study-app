import { NextRequest, NextResponse } from 'next/server';
import { createClient } from '@supabase/supabase-js';
import OpenAI from 'openai';

const supabase = createClient(
  process.env.NEXT_PUBLIC_SUPABASE_URL!,
  process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY!
);

const openai = new OpenAI({
  apiKey: process.env.OPENAI_API_KEY,
});

export async function POST(req: NextRequest) {
  try {
    const formData = await req.formData();
    const file = formData.get('file') as File;

    if (!file) {
      return NextResponse.json({ error: 'ファイルがありません' }, { status: 400 });
    }

    // 1. Supabase Storage へ画像をアップロード
    const arrayBuffer = await file.arrayBuffer();
    const buffer = Buffer.from(arrayBuffer);
    const fileName = `${Date.now()}_${file.name}`;

    const { data: uploadData, error: uploadError } = await supabase.storage
      .from('question-images')
      .upload(fileName, buffer, { contentType: file.type });

    if (uploadError) {
      return NextResponse.json({ error: uploadError.message }, { status: 500 });
    }

    const { data: urlData } = supabase.storage
      .from('question-images')
      .getPublicUrl(fileName);

    const imageUrl = urlData.publicUrl;

    // 2. GPT-4o による画像解析と台本JSON生成
    const base64Image = buffer.toString('base64');
    const response = await openai.chat.completions.create({
      model: 'gpt-4o',
      messages: [
        {
          role: 'user',
          content: [
            { type: 'text', text: 'この問題を解くためのステップ別解説台本をJSONフォーマットで作成してください。フォーマット: { "steps": [{ "step_number": 1, "title": "タイトル", "narration": "解説ナレーション" }] }' },
            {
              type: 'image_url',
              image_url: { url: `data:${file.type};base64,${base64Image}` },
            },
          ],
        },
      ],
      response_format: { type: 'json_object' },
    });

    const scriptJson = JSON.parse(response.choices[0].message.content || '{}');

    // 3. Supabase Database に保存
    const { data: dbData, error: dbError } = await supabase
      .from('explanations')
      .insert({
        image_url: imageUrl,
        script_json: scriptJson,
      })
      .select()
      .single();

    if (dbError) {
      return NextResponse.json({ error: dbError.message }, { status: 500 });
    }

    return NextResponse.json({ success: true, id: dbData.id, script: scriptJson });
  } catch (error: any) {
    return NextResponse.json({ error: error.message }, { status: 500 });
  }
}
